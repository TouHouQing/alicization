{
  "name": "@proj-alicization/root",
  "type": "module",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "description": "LLM powered virtual character",
  "author": {
    "name": "TouHouQing",
    "email": "qinghaoyang@foxmail.com",
    "url": "https://github.com/TouHouQing"
  },
  "license": "MIT",
  "scripts": {
    "postinstall": "npx simple-git-hooks && pnpm run build:packages",
    "dev": "pnpm -r -F @proj-alicization/stage-web dev",
    "dev:docs": "pnpm -rF @proj-alicization/docs run dev",
    "dev:ui": "pnpm -rF @proj-alicization/stage-ui run story:dev",
    "dev:web": "pnpm -rF @proj-alicization/stage-web run dev",
    "dev:web:local": "pnpm -F @proj-alicization/server run db:up && pnpm -r --parallel -F @proj-alicization/server -F @proj-alicization/stage-web run dev",
    "dev:web:local:stop": "pnpm -F @proj-alicization/server run db:down",
    "dev:pocket:ios": "pnpm -rF @proj-alicization/stage-pocket run dev:ios",
    "dev:pocket:android": "pnpm -rF @proj-alicization/stage-pocket run dev:android",
    "dev:server": "pnpm -rF @proj-alicization/server-runtime run dev",
    "dev:tamagotchi": "pnpm -rF @proj-alicization/stage-tamagotchi run dev",
    "dev:apps": "pnpm -rF=\"./apps/*\" run --parallel dev",
    "dev:packages": "pnpm -rF=\"./packages/*\" --parallel run dev",
    "build": "turbo run build -F=\"./packages/*\" -F=\"./apps/*\"",
    "build:web": "turbo run build -F @proj-alicization/stage-web",
    "build:tamagotchi": "pnpm -rF @proj-alicization/stage-tamagotchi run app:build",
    "build:apps": "turbo run build -F=\"./apps/*\"",
    "build:packages": "turbo run build -F=\"./packages/*\"",
    "build:crates": "cargo build --workspace",
    "test": "vitest --coverage",
    "test:run": "vitest run",
    "test:alicization-final-gate": "vitest run apps/stage-tamagotchi/src/main/services/alicization/visible-reply/facade.test.ts apps/stage-tamagotchi/src/main/services/alicization/visible-reply/facade-boundary.test.ts apps/stage-tamagotchi/src/main/services/alicization/visible-reply/normal-reply-plan-types.test.ts apps/stage-tamagotchi/src/main/services/alicization/main-chat-provider-fact-filter.test.ts apps/stage-tamagotchi/src/main/services/alicization/main-chat-single-dialogue-mainline-audit.test.ts apps/stage-tamagotchi/src/main/services/alicization/reply-authority-invariants.test.ts apps/stage-tamagotchi/src/main/services/alicization/runtime-governance-visible-reply-authority.test.ts apps/stage-tamagotchi/src/main/services/alicization/runtime-structured-format.test.ts apps/stage-tamagotchi/src/main/services/alicization/main-chat-background-rules.test.ts apps/stage-tamagotchi/src/main/services/alicization/runtime-governance.test.ts apps/stage-tamagotchi/src/main/services/alicization/learning-action-executor.test.ts apps/stage-tamagotchi/src/main/services/alicization/proactive-mind/visible-utterance-realization.test.ts apps/stage-tamagotchi/src/main/services/alicization/proactive-mind/visible-utterance-policy.test.ts apps/stage-tamagotchi/src/main/services/alicization/runtime-delivery-reminders.test.ts apps/stage-tamagotchi/src/main/services/alicization/main-chat-session-replay-harness.test.ts apps/stage-tamagotchi/src/main/services/alicization/replay-benchmark-runtime.test.ts apps/stage-tamagotchi/src/main/services/alicization/replay/final-gates.test.ts apps/stage-tamagotchi/src/main/services/alicization/main-gateway-contract.test.ts apps/stage-tamagotchi/src/main/services/alicization/one-shot-provider-boundary-audit.test.ts apps/stage-tamagotchi/src/main/services/alicization/task-thread-dispatch-owner-audit.test.ts apps/stage-tamagotchi/src/renderer/alicization-dialogue-normalization.test.ts apps/stage-tamagotchi/src/renderer/alicization-chat-structured-record.test.ts packages/stage-ui/src/stores/alicization-visible-reply-guard.test.ts packages/stage-ui/src/stores/alicization-mind-replay.test.ts",
    "lint": "moeru-lint .",
    "lint:fix": "moeru-lint --fix .",
    "lint:rust": "cargo fmt --check && cargo clippy --workspace",
    "lint:swift": "pnpm -rF @proj-alicization/stage-pocket run lint:swift",
    "to-avif": "tsx docs/scripts/avif.ts",
    "typecheck": "pnpm -rF=\"./packages/*\" -F=\"./apps/*\" -F=\"./docs\" --parallel typecheck",
    "up": "taze -w -r -I && pnpm prune && pnpm dedupe",
    "nolyfill": "pnpm dlx nolyfill",
    "open:ios": "pnpm -rF @proj-alicization/stage-pocket run open:ios",
    "knip": "knip"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.6.1",
    "@arethetypeswrong/core": "^0.18.2",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@iconify/utils": "^3.1.0",
    "@moeru/eslint-config": "catalog:",
    "@proj-airi/unocss-preset-chromatic": "^1.0.2",
    "@rolldown/binding-darwin-arm64": "catalog:",
    "@types/node": "^24.10.14",
    "@unocss/eslint-config": "^66.6.2",
    "@unocss/eslint-plugin": "^66.6.2",
    "@unocss/preset-mini": "^66.6.2",
    "@unocss/preset-web-fonts": "^66.6.2",
    "@vitest/coverage-v8": "catalog:vitest",
    "bumpp": "^10.4.1",
    "eslint": "^9.39.3",
    "eslint-plugin-oxlint": "^1.50.0",
    "knip": "catalog:",
    "nano-staged": "catalog:",
    "oxlint": "^1.50.0",
    "playwright": "catalog:",
    "posthog-js": "catalog:",
    "publint": "^0.3.17",
    "rollup": "^4.59.0",
    "simple-git-hooks": "^2.13.1",
    "smol-toml": "^1.6.0",
    "taze": "^19.9.2",
    "tinyexec": "^1.0.2",
    "tsdown": "catalog:",
    "tsx": "^4.21.0",
    "turbo": "^2.8.11",
    "typescript": "~5.9.3",
    "uncrypto": "^0.1.3",
    "unocss": "^66.6.2",
    "unocss-preset-scrollbar": "^3.2.0",
    "unplugin-lightningcss": "^0.4.5",
    "unplugin-raw": "^0.6.4",
    "unplugin-unused": "^0.5.7",
    "unplugin-vue": "^7.1.1",
    "vite": "^7.3.1",
    "vite-plugin-inspect": "^11.3.3",
    "vitest": "^4.0.18",
    "yaml": "^2.8.2"
  },
  "workspaces": [
    "packages/**",
    "plugins/**",
    "services/**",
    "examples/**",
    "docs/**",
    "apps/**"
  ],
  "simple-git-hooks": {
    "pre-commit": "pnpm nano-staged"
  },
  "nano-staged": {
    "*": "moeru-lint --fix"
  }
}

server {
  listen 80;
  server_name alz.tohoqing.com;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  server_name alz.tohoqing.com;

  # Keep your existing TLS certificate settings here.
  # ssl_certificate ...
  # ssl_certificate_key ...

  root /www/wwwroot/alizication;
  index index.html;

  location / {
    try_files $uri $uri/ /index.html;
  }

  # Same-domain API proxy (apps/server docker-compose => 127.0.0.1:6112).
  location /api/ {
    proxy_http_version 1.1;
    proxy_pass http://127.0.0.1:6112;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Chat stream uses NDJSON; disable buffering for streaming responses.
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }
}

{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "target": "ESNext",
    "jsx": "preserve",
    "lib": [
      "ESNext"
    ],
    "useDefineForClassFields": true,
    "resolveJsonModule": true,
    "types": [
      "vitest",
      "vite/client",
      "electron-vite/node",
      "unplugin-info/client"
    ],
    "allowJs": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "../../uno.config.ts",
    "uno.config.ts",
    "electron.vite.config.ts",

    "../../packages/stage-ui/src/stores/chat-entry-awareness-audit.ts",
    "../../apps/stage-web/src/pages/index.voice.ts",
    "../../apps/stage-web/src/pages/devtools/performance-playground.chat.ts",
    "../../apps/stage-pocket/src/pages/index.voice.ts",
    "../../apps/stage-pocket/src/pages/devtools/performance-playground.chat.ts",

    "src/main/**/*.ts",
    "src/main/**/*.d.ts",
    "src/main/**/*.tsx",
    "src/main/**/*.vue",

    "src/renderer/pages/index.desktop.ts",
    "src/shared/**/*.ts",
    "src/shared/**/*.d.ts",
    "src/shared/**/*.tsx",
    "src/shared/**/*.vue"
  ]
}

{
  "name": "@proj-alicization/cap-vite",
  "type": "module",
  "version": "0.3.0",
  "description": "CLI that starts a Vite dev server and runs Capacitor live reload",
  "author": {
    "name": "TouHouQing",
    "email": "qinghaoyang@foxmail.com",
    "url": "https://github.com/TouHouQing"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TouHouQing/alicization.git",
    "directory": "packages/cap-vite"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "cap-vite": "./dist/bin/run.mjs"
  },
  "files": [
    "README.md",
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "node ../../node_modules/typescript/bin/tsc --noEmit"
  },
  "peerDependencies": {
    "@capacitor/cli": "^8.0.0",
    "vite": "^7.0.0 || ^8.0.0-beta.0"
  },
  "dependencies": {
    "cac": "^6.7.14",
    "tinyexec": "^1.0.2"
  }
}
